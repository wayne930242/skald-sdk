{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skald/template/v1",
  "title": "Skald Template Schema",
  "description": "Schema for Skald character sheet template files",
  "type": "object",
  "required": ["id", "name", "version", "schemaId", "pages"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this template"
    },
    "name": { "type": "string", "description": "Display name of the template" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the template"
    },
    "schemaId": {
      "type": "string",
      "description": "Reference to the field schema this template uses"
    },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "scopedStyles": {
      "type": "object",
      "description": "Versioned style variables and Scoped Template CSS source",
      "properties": {
        "variables": {
          "type": "object",
          "patternProperties": { "^--skald-[a-z0-9-]+$": { "type": "string" } },
          "additionalProperties": false
        },
        "css": { "type": "string" }
      },
      "additionalProperties": false
    },
    "printSettings": {
      "type": "object",
      "properties": {
        "pageSize": { "type": "string", "enum": ["A4", "Letter", "A5"] },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "margins": {
          "type": "object",
          "properties": {
            "top": { "type": "string" },
            "right": { "type": "string" },
            "bottom": { "type": "string" },
            "left": { "type": "string" }
          }
        },
        "printBackground": { "type": "boolean" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/page" }
    },
    "header": {
      "type": "object",
      "description": "Identity row (portrait, title, subtitle) for a template rendered from `pages`; views.web.header wins when present. Field ids from the schema; without `title` the name field is used.",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "portrait": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "views": {
      "type": "object",
      "description": "Optional alternative layout trees. `pages` stays the print (A4) layout; without views.web the web view renders `pages`.",
      "properties": { "web": { "$ref": "#/definitions/webView" } },
      "additionalProperties": false
    }
  },
  "definitions": {
    "page": {
      "type": "object",
      "required": ["id", "layout", "children"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "size": { "type": "string", "enum": ["A4", "Letter", "A5"] },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "margin": {
          "type": "string",
          "enum": ["none", "xs", "sm", "md", "lg", "xl"]
        },
        "layout": { "$ref": "#/definitions/layout" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/element" }
        },
        "customClass": {
          "type": "string",
          "pattern": "^skald-user-[a-z0-9-]+$"
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["stack", "grid"] },
        "direction": { "type": "string", "enum": ["row", "column"] },
        "columns": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "baseColumns": {
          "type": "integer",
          "minimum": 1,
          "description": "Columns below the sm breakpoint (640px) when a `pages` layout renders in web mode; print is unaffected. Ignored in `views.web` sections (they position fields with `at`). Defaults to 1 (stacked); capped at the column count."
        },
        "gap": {
          "type": "string",
          "enum": ["none", "xs", "sm", "md", "lg", "xl"]
        },
        "align": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch"]
        },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "between", "around"]
        }
      }
    },
    "layoutPartial": {
      "type": "object",
      "description": "A layout whose properties are all optional (per-breakpoint override); mirrors the web view layout accepted by the template zod schema",
      "properties": {
        "type": { "type": "string", "enum": ["stack", "grid", "fixed"] },
        "direction": { "type": "string", "enum": ["row", "column"] },
        "columns": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "rows": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "gap": { "type": "string" },
        "columnGap": { "type": "string" },
        "rowGap": { "type": "string" }
      }
    },
    "layoutOverrides": {
      "type": "object",
      "description": "Per-breakpoint layout overrides (container width: md >= 720px, lg >= 1200px)",
      "properties": {
        "md": { "$ref": "#/definitions/layoutPartial" },
        "lg": { "$ref": "#/definitions/layoutPartial" }
      },
      "additionalProperties": false
    },
    "fieldRefLayout": {
      "type": "object",
      "properties": {
        "width": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "height": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "minWidth": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "maxWidth": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "padding": { "type": "string" },
        "margin": { "type": "string" },
        "hidden": { "type": ["boolean", "string"] },
        "printHidden": { "type": "boolean" },
        "screenHidden": { "type": "boolean" }
      }
    },
    "fieldRefOverrides": {
      "type": "object",
      "description": "Per-breakpoint field reference layout overrides",
      "properties": {
        "md": { "$ref": "#/definitions/fieldRefLayout" },
        "lg": { "$ref": "#/definitions/fieldRefLayout" }
      },
      "additionalProperties": false
    },
    "sheetModes": {
      "type": "array",
      "description": "Modes in which the node is shown; omitted means both",
      "minItems": 1,
      "items": { "type": "string", "enum": ["play", "edit"] },
      "uniqueItems": true
    },
    "webView": {
      "type": "object",
      "required": ["id", "layout", "children"],
      "properties": {
        "id": { "type": "string" },
        "header": {
          "type": "object",
          "description": "Identity row read by the host; every value is a schema field id",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "subtitle": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "portrait": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "layout": { "$ref": "#/definitions/layout" },
        "at": { "$ref": "#/definitions/layoutOverrides" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/webElement" }
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/definitions/section" },
        { "$ref": "#/definitions/fieldRef" },
        { "$ref": "#/definitions/heading" }
      ]
    },
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "section" },
        "title": { "type": "string" },
        "titleVariant": {
          "type": "string",
          "enum": ["default", "underlined", "boxed"]
        },
        "layout": { "$ref": "#/definitions/layout" },
        "mobileLayout": {
          "$ref": "#/definitions/layout",
          "description": "Alternative layout for mobile/web view mode"
        },
        "sectionLayout": {
          "type": "object",
          "properties": {
            "width": { "type": "string" },
            "height": { "type": "string" },
            "marginTop": { "type": "string" }
          }
        },
        "border": { "type": "string", "enum": ["none", "solid", "dashed"] },
        "visibleWhen": {
          "type": "string",
          "description": "Condition expression for conditional visibility"
        },
        "customClass": {
          "type": "string",
          "pattern": "^skald-user-[a-z0-9-]+$"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/element" }
        }
      }
    },
    "stickyValue": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "top": { "type": "string" },
            "maxHeight": { "const": "viewport" }
          },
          "additionalProperties": false
        }
      ]
    },
    "fieldRef": {
      "type": "object",
      "required": ["type", "fieldId"],
      "properties": {
        "type": { "const": "field-ref" },
        "fieldId": { "type": "string" },
        "label": { "type": "string" },
        "printGrid": {
          "type": "object",
          "description": "Semantic 12-column placement used by renderer in print and web view",
          "required": ["span"],
          "properties": {
            "span": { "type": "integer", "minimum": 1, "maximum": 12 },
            "start": { "type": "integer", "minimum": 1, "maximum": 12 }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "width": { "type": "string" },
            "height": { "type": "string" }
          }
        },
        "visibleWhen": {
          "type": "string",
          "description": "Condition expression for conditional visibility"
        },
        "customClass": {
          "type": "string",
          "pattern": "^skald-user-[a-z0-9-]+$"
        }
      }
    },
    "heading": {
      "type": "object",
      "required": ["type", "level", "text"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" },
        "variant": { "type": "string", "enum": ["default", "inline"] }
      }
    },
    "webSection": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "section" },
        "title": { "type": "string" },
        "titleVariant": {
          "type": "string",
          "enum": ["default", "underlined", "boxed"]
        },
        "layout": { "$ref": "#/definitions/layout" },
        "mobileLayout": {
          "$ref": "#/definitions/layout",
          "description": "Alternative layout for mobile/web view mode"
        },
        "sectionLayout": {
          "type": "object",
          "properties": {
            "width": { "type": "string" },
            "height": { "type": "string" },
            "marginTop": { "type": "string" }
          }
        },
        "border": { "type": "string", "enum": ["none", "solid", "dashed"] },
        "visibleWhen": {
          "type": "string",
          "description": "Condition expression for conditional visibility"
        },
        "customClass": {
          "type": "string",
          "pattern": "^skald-user-[a-z0-9-]+$"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/webElement" }
        },
        "display": {
          "description": "views.web only. tabs turns child sections into tabs",
          "oneOf": [
            { "type": "string", "enum": ["stack", "tabs"] },
            {
              "type": "object",
              "required": ["base"],
              "properties": {
                "base": { "type": "string", "enum": ["stack", "tabs"] },
                "md": { "type": "string", "enum": ["stack", "tabs"] },
                "lg": { "type": "string", "enum": ["stack", "tabs"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "sticky": {
          "description": "views.web only. Stick to the top of the container while scrolling",
          "oneOf": [
            { "$ref": "#/definitions/stickyValue" },
            {
              "type": "object",
              "required": ["base"],
              "properties": {
                "base": { "$ref": "#/definitions/stickyValue" },
                "md": { "$ref": "#/definitions/stickyValue" },
                "lg": { "$ref": "#/definitions/stickyValue" }
              },
              "additionalProperties": false
            }
          ]
        },
        "at": { "$ref": "#/definitions/layoutOverrides" },
        "modes": { "$ref": "#/definitions/sheetModes" },
        "slot": {
          "type": "string",
          "enum": ["campaign-rules"],
          "description": "views.web only. Reserved position for host-injected content"
        },
        "visible": { "$ref": "#/definitions/responsiveBoolean" }
      }
    },
    "webFieldRef": {
      "type": "object",
      "required": ["type", "fieldId"],
      "properties": {
        "type": { "const": "field-ref" },
        "fieldId": { "type": "string" },
        "label": { "type": "string" },
        "printGrid": {
          "type": "object",
          "description": "Semantic 12-column placement used by renderer in print and web view",
          "required": ["span"],
          "properties": {
            "span": { "type": "integer", "minimum": 1, "maximum": 12 },
            "start": { "type": "integer", "minimum": 1, "maximum": 12 }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "width": { "type": "string" },
            "height": { "type": "string" }
          }
        },
        "visibleWhen": {
          "type": "string",
          "description": "Condition expression for conditional visibility"
        },
        "customClass": {
          "type": "string",
          "pattern": "^skald-user-[a-z0-9-]+$"
        },
        "display": {
          "description": "views.web only. Display variant interpreted by the field renderer",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": ["base"],
              "properties": {
                "base": { "type": "string", "minLength": 1 },
                "md": { "type": "string", "minLength": 1 },
                "lg": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "modes": { "$ref": "#/definitions/sheetModes" },
        "at": { "$ref": "#/definitions/fieldRefOverrides" },
        "visible": { "$ref": "#/definitions/responsiveBoolean" }
      }
    },
    "webElement": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/definitions/webSection" },
        { "$ref": "#/definitions/webFieldRef" },
        { "$ref": "#/definitions/heading" }
      ]
    },
    "responsiveBoolean": {
      "description": "Visibility per container breakpoint; default true",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["base"],
          "properties": {
            "base": { "type": "boolean" },
            "md": { "type": "boolean" },
            "lg": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
