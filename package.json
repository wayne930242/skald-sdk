{
  "name": "skald-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "systems/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "bun run --filter=@skald/dice test && bun run --filter=@skald/formula test && bun run --filter=@skald/sheet-sdk test && bun run --filter=@skald/system-fate test && bun run --filter=@skald/system-dnd5e test",
    "ci": "bun run typecheck && bun run lint && bun run check:packs && bun run test && bun run build",
    "dev": "bun run --filter=@skald/previewer dev",
    "build": "bun run --filter=@skald/previewer build",
    "pack": "bun systems/dnd5e/content-pack/open/cli.ts",
    "system-pack": "bun packages/sheet-sdk/src/scripts/system-pack/cli.ts",
    "check:packs": "bun scripts/check-pack-files.ts"
  },
  "overrides": {
    "parse5": "8.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.8",
    "@types/node": "20.19.30",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
