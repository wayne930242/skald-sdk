    "syntaxHelp": {
      "title": "擲骰語法說明",
      "description": "支援標準骰子記號與進階修飾符",
      "sections": {
        "basic": {
          "title": "基本語法",
          "items": [
            {
              "syntax": "NdM",
              "desc": "擲 N 顆 M 面骰",
              "example": "2d6, 1d20"
            },
            {
              "syntax": "NdF",
              "desc": "擲 N 顆命運骰（-1, 0, +1）",
              "example": "4dF"
            },
            {
              "syntax": "+N / -N",
              "desc": "加減修正值",
              "example": "1d20+5"
            },
            {
              "syntax": "×N 或 *N",
              "desc": "結果乘以 N",
              "example": "3d6×5"
            },
            {
              "syntax": "組合",
              "desc": "可組合多組骰子",
              "example": "2d6+1d8+3"
            }
          ]
        },
        "keepDrop": {
          "title": "保留/丟棄",
          "items": [
            {
              "syntax": "kN / khN",
              "desc": "保留最高 N 顆",
              "example": "4d6kh3"
            },
            {
              "syntax": "klN",
              "desc": "保留最低 N 顆",
              "example": "4d6kl1"
            },
            {
              "syntax": "dhN",
              "desc": "丟棄最高 N 顆",
              "example": "4d6dh1"
            },
            {
              "syntax": "dN / dlN",
              "desc": "丟棄最低 N 顆",
              "example": "4d6dl1"
            }
          ]
        },
        "exploding": {
          "title": "爆炸骰",
          "items": [
            {
              "syntax": "!",
              "desc": "擲到最大值時額外擲一顆",
              "example": "1d6!"
            },
            {
              "syntax": "!!",
              "desc": "擲到最大值時累加到同一顆",
              "example": "1d6!!"
            },
            {
              "syntax": "!p",
              "desc": "爆炸但額外骰 -1",
              "example": "1d6!p"
            },
            {
              "syntax": "!>N",
              "desc": "自訂爆炸門檻",
              "example": "1d6!>5"
            }
          ]
        },
        "reference": {
          "title": "角色屬性參照",
          "items": [
            {
              "syntax": "{{#name[args]}}",
              "desc": "呼叫系統擲骰巨集並帶入參數（支援 #name[args] 簡寫）",
              "example": "#coc[@str] 或 {{#coc[@str]}}"
            },
            {
              "syntax": "{{@attr}}",
              "desc": "參照角色屬性值",
              "example": "1d100+{{@dex}}"
            }
          ]
        }
      }
    },
