  "description": "A content pack in the SDK format. A validator must also enforce the 12 MB UTF-8 file limit, ref = kind:id, the payload checksum, and the rules on refs and names that equal built-in ones (docs/content-packs.md).",
  "properties": {
    "$schema": {
      "const": "skald/pack/v1"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "systemId": {
          "const": "dnd5e-2024"
        },
        "packId": {
          "pattern": "^[a-z0-9][a-z0-9/-]{0,199}$",
          "type": "string"
        },
        "packVersion": {
          "maxLength": 150,
          "minLength": 1,
          "type": "string"
        },
        "notice": {
          "maxLength": 20000,
          "type": "string"
        },
        "payloadSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "requiresBuiltin": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "locales": {
          "items": {
            "enum": [
              "en",
              "zh-TW"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "systemId",
        "packId",
        "packVersion",
        "name",
        "notice",
        "payloadSha256"
      ],
      "type": "object"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "action",
                  "background",
                  "baseItem",
                  "chapter",
                  "class",
                  "classFeature",
                  "condition",
                  "creature",
                  "feat",
                  "item",
                  "itemGroup",
                  "itemMastery",
                  "itemProperty",
                  "language",
                  "lineage",
                  "optionalFeature",
                  "rule",
                  "skill",
                  "species",
                  "spell",
                  "status",
                  "subclass",
                  "subclassFeature",
                  "table"
                ]
              },
              "id": {
                "pattern": "^[a-z0-9][a-z0-9/-]{0,199}$",
                "type": "string"
              },
              "ref": {
                "pattern": "^(?:action|background|baseItem|chapter|class|classFeature|condition|creature|feat|item|itemGroup|itemMastery|itemProperty|language|lineage|optionalFeature|rule|skill|species|spell|status|subclass|subclassFeature|table):[a-z0-9][a-z0-9/-]{0,199}$",
                "type": "string"
              },
              "name": {
                "maxLength": 20000,
                "type": "string"
              },
              "entries": {
                "items": {
                  "$ref": "#/definitions/node11"
                },
                "maxItems": 5000,
                "type": "array"
              },
              "meta": {
                "additionalProperties": {
                  "$ref": "#/definitions/node12"
                },
                "propertyNames": {
                  "maxLength": 20000,
                  "type": "string"
                },
                "type": "object"
              },
              "lore": {
                "items": {
                  "$ref": "#/definitions/block"
                },
                "maxItems": 5000,
                "type": "array"
              },
              "source": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "entries"
            ],
            "type": "object"
          },
          "maxItems": 5000,
          "type": "array"
        },
        "overlays": {
          "additionalProperties": {
            "$ref": "#/definitions/overlay"
          },
          "maxProperties": 5000,
          "propertyNames": {
            "pattern": "^(?:action|background|baseItem|chapter|class|classFeature|condition|creature|feat|item|itemGroup|itemMastery|itemProperty|language|lineage|optionalFeature|rule|skill|species|spell|status|subclass|subclassFeature|table):[a-z0-9][a-z0-9/-]{0,199}$",
            "type": "string"
          },
          "type": "object"
        },
