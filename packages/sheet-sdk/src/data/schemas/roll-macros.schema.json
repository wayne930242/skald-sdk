{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skald/roll-macros/v1",
  "title": "Skald Roll Macros Configuration",
  "description": "Roll macro definitions for game systems",
  "type": "object",
  "required": ["macros"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultSystem": {
      "type": "string",
      "description": "Default roll system for macros without explicit system",
      "enum": ["coc7", "dnd5e", "fate", "pbta", "generic"]
    },
    "defaultTarget": {
      "type": "string",
      "description": "Default roll target destination",
      "enum": ["session", "chat", "discord", "self"]
    },
    "macros": {
      "type": "object",
      "description": "Macro definitions keyed by macro ID",
      "additionalProperties": {
        "$ref": "#/definitions/rollMacroDefinition"
      }
    }
  },
  "definitions": {
    "rollMacroDefinition": {
      "type": "object",
      "required": ["params", "body"],
      "properties": {
        "params": {
          "type": "array",
          "description": "Ordered parameter declarations, referenced inside the body as @name",
          "items": {
            "$ref": "#/definitions/macroParamDefinition"
          }
        },
        "body": {
          "type": "string",
          "description": "Macro body DSL source: if/elif/else, := field writes, roll(\"...\") for nested/returned rolls, return"
        },
        "label": {
          "type": "string",
          "description": "Display label (can be i18n key like {{i18n:attributes.str}})"
        },
        "system": {
          "type": "string",
          "description": "System identifier (overrides defaultSystem)",
          "enum": ["coc7", "dnd5e", "fate", "pbta", "generic"]
        },
        "target": {
          "type": "string",
          "description": "Roll target destination (overrides defaultTarget)",
          "enum": ["session", "chat", "discord", "self"]
        },
        "bonusDice": {
          "$ref": "#/definitions/bonusDiceConfig"
        },
        "dialog": {
          "$ref": "#/definitions/dialogConfig"
        }
      }
    },
    "macroParamDefinition": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name (must not be rolled/target/total/margin — reserved)"
        },
        "default": {
          "type": "string",
          "description": "Formula-string default used when the call omits this argument"
        }
      }
    },
    "bonusDiceConfig": {
      "type": "object",
      "description": "Bonus/penalty dice picker UI configuration (CoC7e style)",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether bonus dice are enabled for this macro"
        },
        "min": {
          "type": "integer",
          "description": "Minimum bonus dice value (negative for penalty)",
          "minimum": -10,
          "maximum": 0
        },
        "max": {
          "type": "integer",
          "description": "Maximum bonus dice value",
          "minimum": 0,
          "maximum": 10
        },
        "param": {
          "type": "string",
          "description": "Name of the macro parameter the picker's chosen value overrides at roll time (D12)"
        }
      }
    },
    "dialogConfig": {
      "type": "object",
      "description": "Dialog configuration for additional inputs",
      "properties": {
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["number", "select", "text"] },
              "label": { "type": "string" },
              "defaultValue": {}
            }
          }
        }
      }
    }
  }
}
